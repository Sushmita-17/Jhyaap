# Supabase Configuration (optional - will use SQLite if not provided)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database Configuration (optional - will use SQLite if not provided)
# Get connection string from Supabase Dashboard → Settings → Database → Connection String → URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.jbibgtqxjckuaidmodvo.supabase.co:5432/postgres
DATABASE_URL=
USE_POSTGRESQL=false  # Set to true to force PostgreSQL connection (may timeout due to network issues)

# App Configuration
APP_NAME=Jhyaap Station API
APP_ENV=development
DEBUG=false

# OTP Configuration
OTP_MODE=mock

# Security Configuration (REQUIRED)
# Generate a strong secret key using: python -c "import secrets; print(secrets.token_hex(32))"
# Or use: openssl rand -hex 32 (if available)
# NEVER use the example key in production - generate your own!
SECRET_KEY=7caf389b84c0a508a8405ffbaa6a3dbca1ac994f97659366ba482e34e9893d6c
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Configuration (required for OTP storage)
REDIS_URL=redis://localhost:6379/0

# Payment Gateway Configuration (optional)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=

# SMS Configuration (optional - for OTP delivery)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Backend Public URL (for image uploads and static file serving)
BACKEND_PUBLIC_URL=http://127.0.0.1:8001
